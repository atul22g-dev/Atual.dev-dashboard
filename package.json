{
  "name": "Atual.dev-dashboard",
  "version": "1.0.0",
  "description": "A modern desktop system monitoring dashboard built with Electron.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "doctor": "npx react-doctor@latest",
    "test": "node --test",
    "script:Phase0": "npm run build && node ./scripts/evidence.js all && node ./scripts/launch-stability.js 30",
    "script:Phase0:measure": "npm run build && node ./scripts/evidence.js measure",
    "script:Phase0:capture": "npm run build && node ./scripts/evidence.js capture",
    "script:Phase0:stability": "npm run build && node ./scripts/launch-stability.js 30",
    "script:Phase1": "npm run build && node ./scripts/verify-phase1.js"
  },
  "author": "Atual.dev",
  "license": "MIT",
  "build": {
    "appId": "dev.atual.dashboard",
    "productName": "Atual.dev Dashboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atual.dev Dashboard"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
